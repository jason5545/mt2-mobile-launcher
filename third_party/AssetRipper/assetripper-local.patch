+using AssetRipper.Export.Configuration;
+using AssetRipper.Export.UnityProjects;
+using AssetRipper.Import.Logging;
+using AssetRipper.IO.Files;
+
+namespace AssetRipper.CLI;
+
+class Program
+{
+    static void Main(string[] args)
+    {
+        // Handle --test
+        if (args.Length > 0 && args[0] == "--test")
+        {
+            Environment.Exit(Tests.Run());
+            return;
+        }
+
+        if (args.Length < 2)
+        {
+            Console.WriteLine("Usage: AssetRipper.CLI <input_path> <output_path> [options]");
+            Console.WriteLine("       AssetRipper.CLI --test");
+            Console.WriteLine();
+            Console.WriteLine("Options:");
+            Console.WriteLine("  --dll-no-rename       Export DLLs without renaming (preserves original names)");
+            Console.WriteLine("  --dll-rename          Export DLLs with compatible renaming");
+            Console.WriteLine("  --decompile           Decompile scripts to C# (default)");
+            Console.WriteLine("  --decompile-game-only Decompile only game scripts (Assembly-CSharp)");
+            Console.WriteLine("  --shader-yaml         Export shaders as YAML assets (preserves compiled bytecode)");
+            Console.WriteLine("  --shader-decompile    Decompile shaders to HLSL source code");
+            Console.WriteLine("  --test                Run tests");
+            return;
+        }
+
+        string inputPath = args[0];
+        string outputPath = args[1];
+
+        // Parse options
+        ScriptExportMode scriptMode = ScriptExportMode.Hybrid;
+        ShaderExportMode shaderMode = ShaderExportMode.Dummy;
+        for (int i = 2; i < args.Length; i++)
+        {
+            switch (args[i])
+            {
+                case "--dll-no-rename":
+                    scriptMode = ScriptExportMode.DllExportWithoutRenaming;
+                    break;
+                case "--dll-rename":
+                    scriptMode = ScriptExportMode.DllExportWithRenaming;
+                    break;
+                case "--decompile":
+                    scriptMode = ScriptExportMode.Decompiled;
+                    break;
+                case "--decompile-game-only":
+                    scriptMode = ScriptExportMode.DecompiledGameOnly;
+                    break;
+                case "--shader-yaml":
+                    shaderMode = ShaderExportMode.Yaml;
+                    break;
+                case "--shader-decompile":
+                    shaderMode = ShaderExportMode.Decompile;
+                    break;
+            }
+        }
+
+        // Setup logging
+        Logger.Add(new ConsoleLogger());
+        Logger.LogSystemInformation("AssetRipper CLI");
+
+        // Create configuration
+        FullConfiguration settings = new();
+        settings.ExportSettings.ScriptExportMode = scriptMode;
+        settings.ExportSettings.ShaderExportMode = shaderMode;
+
+        Console.WriteLine($"Script Export Mode: {scriptMode}");
+        Console.WriteLine($"Shader Export Mode: {shaderMode}");
+        Console.WriteLine($"Input: {inputPath}");
+        Console.WriteLine($"Output: {outputPath}");
+        Console.WriteLine();
+
+        // Export
+        ExportHandler handler = new(settings);
+
+        try
+        {
+            handler.LoadProcessAndExport(new[] { inputPath }, outputPath, LocalFileSystem.Instance);
+            Console.WriteLine("Export completed successfully!");
+        }
+        catch (Exception ex)
+        {
+            Console.WriteLine($"Export failed: {ex.Message}");
+            Console.WriteLine(ex.StackTrace);
+            Environment.Exit(1);
+        }
+    }
+}
