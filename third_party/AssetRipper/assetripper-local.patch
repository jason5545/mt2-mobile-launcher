+using AssetRipper.Export.UnityProjects.Scripts;
+using System.Security.Cryptography;
+using System.Text;
+
+namespace AssetRipper.CLI;
+
+public static class Tests
+{
+    public static int Run()
+    {
+        Console.WriteLine("=== AssetRipper CLI Tests ===\n");
+
+        int passed = 0;
+        int failed = 0;
+
+        // Test 1: FileID calculation
+        Console.WriteLine("Test 1: FileID Calculation (ScriptHashing)");
+        var fileIdTests = new (string ns, string name, int expected)[]
+        {
+            ("UnityEngine", "Component", 468326297),
+            ("UnityEngine", "GameObject", -1741091355),
+            ("UnityEngine", "MonoBehaviour", 888015496),
+            ("UnityEngine", "Object", 350709172),
+        };
+
+        foreach (var (ns, name, expected) in fileIdTests)
+        {
+            int calculated = ScriptHashing.CalculateScriptFileID(ns, name);
+            bool ok = calculated == expected;
+            Console.WriteLine($"  {(ok ? "✓" : "✗")} {ns}.{name}: {calculated} (expected {expected})");
+            if (ok) passed++; else failed++;
+        }
+
+        // Test 2: Assembly GUID calculation
+        Console.WriteLine("\nTest 2: Assembly GUID Calculation");
+        var guidTests = new (string assemblyName, string expectedGuid)[]
+        {
+            ("Assembly-CSharp", "543ddd06bf16ea43368cc39ff96e6d5a"),
+            ("Assembly-CSharp-firstpass", "bc60a4a6da9ca868c89553f1ec5be757"),
+        };
+
+        foreach (var (assemblyName, expectedGuid) in guidTests)
+        {
+            string calculated = CalculateAssemblyGuidRaw(assemblyName);
+            bool ok = calculated == expectedGuid;
+            Console.WriteLine($"  {(ok ? "✓" : "✗")} {assemblyName}: {calculated}");
+            if (ok) passed++; else failed++;
+        }
+
+        // Test 3: Game-specific types (no namespace)
+        Console.WriteLine("\nTest 3: Game Types (no namespace)");
+        var gameTypes = new (string ns, string name, int expectedFileId)[]
+        {
+            ("", "AllGameData", 1915479307),
+            ("", "AllGameManagers", 1417479432),
+            ("", "ScreenManager", 219008051),
+            ("", "SaveManager", -285757688),
+        };
+
+        foreach (var (ns, name, expected) in gameTypes)
+        {
+            int calculated = ScriptHashing.CalculateScriptFileID(ns, name);
+            bool ok = calculated == expected;
+            Console.WriteLine($"  {(ok ? "✓" : "✗")} {name}: {calculated} (expected {expected})");
+            if (ok) passed++; else failed++;
+        }
+
+        // Summary
+        Console.WriteLine($"\n=== Results: {passed} passed, {failed} failed ===");
+        return failed > 0 ? 1 : 0;
+    }
+
+    private static string CalculateAssemblyGuidRaw(string assemblyName)
+    {
+        // Remove .dll extension if present
+        if (assemblyName.EndsWith(".dll", StringComparison.OrdinalIgnoreCase))
+        {
+            assemblyName = assemblyName[..^4];
+        }
+
+        byte[] hash = MD5.HashData(Encoding.UTF8.GetBytes(assemblyName));
+        return Convert.ToHexString(hash).ToLowerInvariant();
+    }
+}
