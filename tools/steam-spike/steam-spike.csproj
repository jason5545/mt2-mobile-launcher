<Project Sdk="Microsoft.NET.Sdk">
  <!-- 啟動器殼的第一步：SteamKit2 能不能在 net10.0-android（CoreCLR）上跑。
       不用帳號：連 CM、開 QR 登入的工作階段（不等掃描）、匿名登入、讀 MT2 的 PICS、查 SteamPipe 的 CDN。
       runtime 設定照 tools/phase3/device（CoreCLR、不修剪、不 AOT）。 -->
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <RootNamespace>Mt2Mobile.SteamSpike</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>org.mt2mobile.steamspike</ApplicationId>
    <ApplicationTitle>MT2 Steam spike</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <UseMonoRuntime>false</UseMonoRuntime>
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SteamKit2" Version="3.5.0" />
  </ItemGroup>
</Project>
